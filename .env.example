APP_NAME="School Inspection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolinspection
DB_USERNAME=root
DB_PASSWORD=

# Sessions: Redis when the phpredis extension is loaded, else files (config/session.php).
# SESSION_DRIVER=redis
# Modification V3: sign out after 20 minutes without activity (a warning appears 2 minutes before)
SESSION_LIFETIME=20
SESSION_ENCRYPT=false

# Login protection (Modification V3): CAPTCHA after 2 wrong attempts, account locked for 20 minutes after 3
LOGIN_CAPTCHA_AFTER=2
LOGIN_MATH_CAPTCHA=true
LOGIN_LOCK_AFTER=3
LOGIN_LOCK_MINUTES=20

# Modification V9: show the automatic rating (report, lists, school page, map, Rating Report). Ratings are always calculated.
RATING_DISPLAY=false

# Modification V13: Excel upload limits (seconds, 0 = no limit; memory per upload request)
IMPORT_TIMEOUT=0
IMPORT_MEMORY=2048M
# Most schools in one School Master PDF (larger lists: filter or use Excel)
MASTER_PDF_MAX_ROWS=3000
# Password that unlocks the read-only My Schools Excel (empty = random per file)
# EXCEL_PROTECT_PASSWORD=
# Modification V13: audit entries older than this are archived to Excel and deleted on the 1st of each month
AUDIT_RETENTION_DAYS=30
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache: Redis (in memory) with the file cache as failover; plain "file" when phpredis is missing.
# Check with: php artisan cache:status
CACHE_STORE=failover
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Seconds before a dead Redis is given up and the file cache takes over
REDIS_TIMEOUT=0.5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Kolkata

# First State Administrator (created by seeder; must change password on first login)
ADMIN_NAME="State Administrator"
ADMIN_MOBILE=9999999999
ADMIN_EMPLOYEE_ID=ADMIN001
ADMIN_PASSWORD="Admin@12345"
ADMIN_GENDER=male

# OTP (Phase 2) - log driver only in Phase 1
OTP_DRIVER=log

# ---------------------------------------------------------------
# PRODUCTION checklist (PRD 14)
#   APP_ENV=production            -> forces https:// URLs (AppServiceProvider)
#   APP_DEBUG=false
#   APP_URL=https://<your-domain>
#   SESSION_SECURE_COOKIE=true
#   CAPTCHA_ENABLED=true
#   TEST_DATA_CLEANUP=false        -> Clean Test Data is never available in production (the page is a 404)
#   CLAMAV_BINARY=C:\ClamAV\clamscan.exe   (malware scan of uploads)
#   MAIL_MAILER=smtp + MAIL_* settings     (password reset links)
#   php artisan security:keys       -> RSA key pair for password encryption (V6); back up storage/app/private/keys
#   Speed (fastest): Redis + phpredis for cache and sessions (php artisan cache:status shows it),
#     and OPcache in php.ini: zend_extension=opcache, opcache.enable=1, opcache.memory_consumption=256,
#     opcache.interned_strings_buffer=16, opcache.max_accelerated_files=20000, opcache.validate_timestamps=0
#     (restart Apache after each deploy to clear OPcache)
#   Then run: php artisan config:cache && php artisan route:cache && php artisan view:cache
#   (Never run `php artisan test` on a server with cached config.)
#   Scheduler: Windows Task Scheduler -> every 1 minute:
#     D:\xampp\php\php.exe D:\path\to\app\artisan schedule:run
#     (it also runs audit:purge and cache:purge on the 1st of each month, V13, then db:maintain at 02:30)
#   Faster loading (25-11-2026): in Apache httpd.conf un-comment LoadModule deflate_module, headers_module
#     and expires_module; public/.htaccess then gzips HTML / CSS / JS / JSON / GeoJSON and keeps /build/assets
#     for a year (hashed names). Run `npm run build` on every deploy (it also regenerates the icon subset).
#   SLOW_QUERY_MS=1000             -> queries slower than this are written to the log (0 = off)
#   After deploying 26-11-2026: php artisan evidence:thumbs  (small grid thumbnails for photos already stored; needs extension=gd)
#   LAZY_LOADING_CHECK=log         -> outside production an N+1 query (lazy-loaded relation) is logged (throw | off)
#   Queue worker (26-11-2026, REQUIRED): large Excel / PDF downloads are made in the background (Downloads page).
#     Windows: NSSM service or Task Scheduler "at startup", restarted if it stops:
#       D:\xampp\php\php.exe -d memory_limit=2048M D:\path\to\app\artisan queue:work --timeout=3600 --tries=1 --max-time=3600
#     Linux: supervisor with the same command. Restart it after each deploy: php artisan queue:restart
#     DB_QUEUE_RETRY_AFTER=3700 must stay above --timeout. php artisan cache:status shows waiting / failed jobs.
#     EXPORT_QUEUE=false makes downloads direct again (no worker); EXPORT_KEEP_HOURS=24, EXPORT_MAX_ACTIVE=3 per officer.
#   Large Excel uploads (V13): php.ini upload_max_filesize=64M, post_max_size=64M, max_input_time=600,
#     memory_limit=2048M; Apache httpd-default.conf Timeout 600 (a state-wide School Master takes 2-3 minutes)
# ---------------------------------------------------------------

# Show the demo accounts panel on the login page (ignored when APP_ENV=production)
DEMO_LOGINS=true

# Admin Settings -> Clean Test Data (State Administrator). Local server only: leave on for testing on this machine,
# set false on any shared / staging server. Always off when APP_ENV=production.
TEST_DATA_CLEANUP=true

# Map View (New Module 1). OpenStreetMap's public tiles are for light use only;
# for heavy production use, point these to a self-hosted or commercial tile server.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
MAP_CACHE_SECONDS=60
# Road route from My location to a school (V6 Module 8). The public OSRM demo server is for light use only.
# MAP_ROUTING=true
# MAP_ROUTING_URL=https://router.project-osrm.org

# Inspection schedules (New Module 2): an officer's own day plan needs a higher officer's approval
SCHEDULE_APPROVAL_REQUIRED=true
SCHEDULE_MAX_PER_DAY=8

# Password encryption in the browser (V6 Module 5). Keys: php artisan security:keys
# PASSWORD_ENCRYPTION=true            # send password fields RSA-encrypted
# PASSWORD_ENCRYPTION_REQUIRED=true   # refuse plain-text passwords (load-test mode still accepts them)
